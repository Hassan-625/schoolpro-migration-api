# Copy names only; set real values in the staging Render service dashboard.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_ENV=staging
ENABLE_TEST_ENDPOINTS=false
ALLOW_DESTRUCTIVE_TEST_FIXTURES=false
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Leave false until the exact membership contract has been reviewed and approved.
IDENTITY_MAPPING_VERIFIED=false
IDENTITY_SCHEMA=public
IDENTITY_TABLE=
IDENTITY_USER_ID_COLUMN=
IDENTITY_SCHOOL_ID_COLUMN=
IDENTITY_ROLE_COLUMN=
IDENTITY_ACTIVE_COLUMN=
# Comma-separated, explicitly reviewed test-only role values; empty means fail closed.
TEST_ALLOWED_ROLES=
# UUIDs of synthetic test tenants only; never use production school IDs.
SYNTHETIC_SCHOOL_A_ID=
SYNTHETIC_SCHOOL_B_ID=
# Optional prerequisite check: schema-qualified table name, e.g. public.schoolpro_students
REQUIRED_SCHEMA_TABLES=
